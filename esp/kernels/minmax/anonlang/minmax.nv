def int minmax_anonlang_run(int[] arr, int len, int[] out_minmax)
	if len <= 0
		out_minmax[0] = 0
		out_minmax[1] = 0
		return -1
	int min_val = arr[0]
	int max_val = arr[0]
	for i=1, i<len
		int v = arr[i]
		if v < min_val
			min_val = v
		if v > max_val
			max_val = v
	out_minmax[0] = min_val
	out_minmax[1] = max_val
	return 0
