main
	int n = 4096
	var v = new tensor(float, [n,n])
	var u = new tensor(float, [n,n])

	float flop_mean = 0
	for i=0, i<20
		print("i ", i)
		start_timer()
		var z = v @ u
		float ms = end_timer()
		float flops = 2*pow(n,3) / (ms*1000000)
		print("ms ", ms)
		print("flops ", flops)
		flop_mean+=flops

	print("flop avg ", flop_mean/20)

